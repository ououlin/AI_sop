# 服务配置
HOST=0.0.0.0
PORT=8000

# 摄像头配置
CAMERA_INDEX=0
CAMERA_BACKEND=MSMF
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# 视频配置
JPEG_QUALITY=75
STATUS_INTERVAL=0.2

# 日志配置
LOG_LEVEL=INFO

# 认证与工位上报（生产环境必须替换）
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=24
COOKIE_SECURE=false
STATION_API_KEY=replace-with-a-shared-station-key

# 平台管理员（多租户开通入口；密码留空则不创建）
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=

# 数据库（默认 SQLite；取消注释可切 PostgreSQL）
# DATABASE_URL=postgresql+psycopg2://ai_sop:password@127.0.0.1:5432/ai_sop
# TENANT_SCHEMA=tenant_acme
